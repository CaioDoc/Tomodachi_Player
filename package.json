{
  "name": "manga-video-hub",
  "version": "1.5.9-beta",
  "description": "Mangás & Comics + Vídeos & Animations para Windows",
  "author": "CaioDoc",
  "license": "MIT",
  "homepage": "https://github.com/CaioDoc/Tomodachi_Player#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/CaioDoc/Tomodachi_Player.git"
  },
  "bugs": {
    "url": "https://github.com/CaioDoc/Tomodachi_Player/issues"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"cross-env WAIT_ON_TIMEOUT=60000 npm run electron:wait\"",
    "electron:build": "esbuild electron/main.ts electron/preload.ts --outdir=dist-electron --platform=node --target=node20 --format=cjs --main-fields=main,module --bundle --external:electron && esbuild electron/nuvio/hostPreload.ts --outfile=dist-electron/nuvio-host-preload.js --platform=node --target=node20 --format=cjs --bundle --external:electron && esbuild electron/nuvio/runtime.ts --outfile=dist-electron/nuvio-runtime.js --platform=browser --target=chrome120 --format=iife --bundle && node ./scripts/build-torrent.cjs && node ./scripts/copy-ffmpeg.cjs",
    "electron:dev": "npm run electron:build && electron .",
    "electron:wait": "node ./scripts/wait-and-start.cjs",
    "smoke": "electron smoke.js",
    "build:renderer": "tsc && vite build",
    "build:electron": "npm run electron:build",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --win --dir",
    "atalhos": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/criar-atalhos.ps1"
  },
  "build": {
    "appId": "com.manga.video.hub",
    "productName": "Tomodachi Player",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      }
    ],
    "asarUnpack": [
      "dist-electron/bin/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tomodachi Player",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Tomodachi-Player-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Tomodachi-Player-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.2",
    "tldts-experimental": "^7.4.9",
    "axios": "^1.7.9",
    "cross-fetch": "^4.1.0",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.475.0",
    "pako": "^2.1.0",
    "protobufjs": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "webtorrent": "1.9.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pako": "^2.0.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
